# Optional. Without this, sessions are stored in .data/sessions.json.
DATABASE_URL=postgres://localhost:5432/ai_profile

# Optional. Without a key, narration uses template sentences and
# extract/refine keep the user's own words.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
